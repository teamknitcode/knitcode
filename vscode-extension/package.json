{
  "name": "knitcode-static",
  "displayName": "knitcode",
  "description": "Explore Python callers, callees, static evidence and Git history with the current KnitCode engine.",
  "version": "0.4.0",
  "publisher": "knitcode-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "knitcodeStatic.open",
        "title": "knitcode: Open Call Flow"
      }
    ],
    "configuration": {
      "title": "knitcode",
      "properties": {
        "knitcodeStatic.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.10+ executable path. Empty: python3 on macOS/Linux, python on Windows."
        },
        "knitcodeStatic.historyDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 3650
        },
        "knitcodeStatic.commitLimit": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "maximum": 2000
        },
        "knitcodeStatic.gitValidationAutoRun": {
          "type": "boolean",
          "default": true,
          "description": "Run bounded Git Validation insights automatically after static analysis."
        },
        "knitcodeStatic.gitValidationCommitLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 300,
          "description": "Maximum Git commits for detailed validation (1-300)."
        }
      }
    }
  }
}
